+        await chain.retriever.close()
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("question")
+    parser.add_argument("--variant", choices=["baseline", "adaptive", "verify", "full"], default="full")
