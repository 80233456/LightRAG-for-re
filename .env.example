# LightRAG + Ollama default; no external API key is needed for the demo.
OLLAMA_HOST=http://127.0.0.1:11434
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
LIGHTRAG_WORKDIR=./data/lightrag_store
GENERATION_TIMEOUT=300
VERIFIER_BACKEND=lexical
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
SUPPORT_THRESHOLD=0.78
CONTRADICTION_THRESHOLD=0.70
NLI_DEVICE=cpu

# Optional: mirror the 2026-10-14 DeepSeek API + local BGE-M3 environment.
# Keep LLM_API_KEY ONLY in a private environment or untracked .env file.
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# EMBEDDING_BACKEND=sentence_transformers
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cuda
# NLI_DEVICE=cuda
# API_USAGE_LOG=results/api_usage.jsonl
# LLM_MAX_ASYNC=2
