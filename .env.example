# LightRAG + Ollama (real backend only); first run `ollama pull qwen2.5:7b` and `ollama pull bge-m3`
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
LIGHTRAG_WORKDIR=./data/lightrag_store
GENERATION_TIMEOUT=300
# lexical = offline algorithm smoke-test; nli = research-grade model-based inference after calibration
VERIFIER_BACKEND=lexical
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
SUPPORT_THRESHOLD=0.78
CONTRADICTION_THRESHOLD=0.70
